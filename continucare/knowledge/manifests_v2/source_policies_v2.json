      "license_posture": "needs_verification",
      "terms_uri": null,
      "operation_rules": [
        {
          "operation": "register_link_metadata",
          "decision": "allow",
          "rationale": "机器可以登记精确链接和来源元数据，但这不是内容复用许可。"
        },
        {
          "operation": "discover_metadata",
          "decision": "allow",
          "rationale": "只允许无患者数据的来源发现与元数据候选生成。"
        },
        {
          "operation": "fetch_for_change_detection",
          "decision": "offline_fixture_only",
          "rationale": "本阶段仅用 synthetic offline fixture 验证变更检测。"
        },
        {
          "operation": "persist_snapshot",
          "decision": "offline_fixture_only",
          "rationale": "真实正文持久化需先完成官方复用条款与 rights review。"
        },
        {
          "operation": "persist_full_text",
          "decision": "review_required",
          "rationale": "公开可见不等于允许本地保存或商业复用。"
        },
        {
          "operation": "short_quote",
          "decision": "review_required",
          "rationale": "引用范围和商业用途必须由 rights officer 判断。"
        },
        {
          "operation": "translate",
          "decision": "review_required",
          "rationale": "翻译可能构成改编，且必须临床复核。"
        },
        {
          "operation": "adapt",
          "decision": "review_required",
          "rationale": "不得从说明书自动综合生成 ContinuCare 临床主张。"
        },
        {
          "operation": "commercial_use",
          "decision": "review_required",
          "rationale": "按未来商业产品标准逐项核验。"
        },
        {
          "operation": "model_training",
          "decision": "deny",
          "rationale": "本阶段禁止将来源正文用于模型训练。"
        },
        {
          "operation": "vector_index",
          "decision": "deny",
          "rationale": "本阶段不建立未经许可的正文向量索引。"
        }
      ],
      "live_network_enabled": false,
      "status": "active",
      "registered_at": "2026-08-14T00:00:00+02:00",
      "registered_by": "system:knowledge-ops-design",
      "notes": [
        "该 policy 是 default-deny 操作约束，不是正式许可结论。",
        "NMPA 公开查询的系统化复用/API 条款目前保持 NEEDS_VERIFICATION。"
      ]
